# Copy this file to .env and fill in real values.
# `netlify dev` loads .env automatically for both the static site and
# netlify/functions/employees.js — no extra config needed.
# NEVER commit your actual .env file.

# Fine-grained GitHub PAT, scoped to this repo only, with
# "Contents: Read and write" permission. Required.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults already match this repo, override only if needed.
GITHUB_OWNER=knockoutdev042
GITHUB_REPO=knockout-employee-portal

# Which branch the function reads/writes. IMPORTANT for local testing:
# point this at a throwaway/dev branch (not main) so test edits don't
# spam your real commit history. The function commits for real, even
# when run locally.
GITHUB_BRANCH=claude/employee-mgmt-planning-8qprlr
